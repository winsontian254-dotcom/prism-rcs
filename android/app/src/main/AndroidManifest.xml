<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets another app (Prism Launcher) read the RCS chats and act on them. The user grants it,
         as they would SMS access. -->
    <permission
        android:name="dev.prism.rcs.permission.CHATS"
        android:description="@string/permission_chats_description"
        android:label="@string/permission_chats_label"
        android:protectionLevel="dangerous" />

    <!-- The linked session is a credential: keep it out of backups and device transfers. -->
    <application
        android:name=".RcsApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PrismRcs">

        <!--
            No chat screens and no app-list icon: the chats are read through ChatsProvider by an
            app that shows them (Prism Launcher's Messaging). This activity is only for linking,
            unlinking and the about page. Prism opens it with action dev.prism.rcs.OPEN and
            Intent.FLAG_ACTIVITY_NO_ANIMATION, handing over its look as style.* extras.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="dev.prism.rcs.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <provider
            android:name=".ChatsProvider"
            android:authorities="dev.prism.rcs.chats"
            android:exported="true"
            android:readPermission="dev.prism.rcs.permission.CHATS"
            android:writePermission="dev.prism.rcs.permission.CHATS" />
    </application>
</manifest>
